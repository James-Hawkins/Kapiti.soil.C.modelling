)
ggplot( d.all[ d.all$sw.5 > 0 ,  ] ,   aes(x = date.time)
) +
geom_line( aes(x = date.time, y = swc.3.osv * 100  , color= p.swc.osv.label , alpha = variable.status , linetype = variable.status
)
, linewidth = p.ln.width
# , linetype = 'solid'
) +
scale_alpha_manual( breaks = c('filled' , 'actual') , values = c(0.5 , 0.5) )
ggplot( d.all[ d.all$sw.5 > 0 ,  ] ,   aes(x = date.time)
) +
geom_line( aes(x = date.time, y = swc.3.osv * 100  , color= p.swc.osv.label , alpha = variable.status , linetype = variable.status
)
, linewidth = p.ln.width
# , linetype = 'solid'
) +
scale_alpha_manual( breaks = c('filled' , 'actual') , values = c(1 , 0.0) )
ggplot( d.all[ d.all$sw.5 > 0 ,  ] ,   aes(x = date.time)
) +
geom_line( aes(x = date.time, y = swc.3.osv * 100  , color= p.swc.osv.label
)
, linewidth = p.ln.width
) +
geom_line( aes(x = date.time, y = sw.5  , color= p.swc.sim.label )
, linewidth = p.ln.width
