<?xml version="1.3" ?>
<ldndcproject PackageMinimumVersionRequired="1.3">

    <description>
        <author></author>
        <email></email>
        <date></date>
        <dataset></dataset>
        <version></version>
        <source></source>
    </description>

    <schedule time="2023-04-20/24 -> 2024-05-12"/>

    <input>
        <sources sourceprefix="KE_kapiti_Base/KE_kapiti_">
           
		     <site source="site_eddy_Ferral_ISRIC_9+P8.xml"/>
         
			 <!--
			    <site source="site_eddy_Vertisol_P4-wcmin.xml"/>
			   <site source="site_eddy_Ferral_ISRIC_9+P8.xml"/>
			   <site source="site_eddy_Vertisol_P4.xml"/>
			    <site source="site_eddy_Vertisol_P7.xml"/>
				 <site source="site_eddy_Vertisol_P12.xml"/>
				-->
            <event source="events_eddy.xml"/>
            <climate source="climate_eddy.txt" format="txt"/>
            <setup source="setup.xml"/>
            <airchemistry format="txt" source="airchemistry_eddy.txt"/>
            <!--parameter files-->
            <speciesparameters source="speciesparameters+JH.xml"/>
            <siteparameters source="siteparameters.xml"/>
        </sources>

        <attributes use="0">
            <airchemistry endless="0"/>
        </attributes>

    </input>

    <output>
        <sinks sinkprefix="KE_kapiti_Base/KE_Kapiti_output_eddy/KE_Kapiti_" />
    </output>

</ldndcproject>
