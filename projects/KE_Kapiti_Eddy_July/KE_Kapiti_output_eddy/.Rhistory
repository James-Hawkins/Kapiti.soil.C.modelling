cols.2.average
d.all$ag.biom.grass.Mg.ha
cols.2.average <- c( 'GPP.sim' , 'TER.sim' , 'NEE.mod' , 'ag.biom.grass.kg.ha')
{
cols.2.average <- c( 'GPP.sim' , 'TER.sim' , 'NEE.mod' , 'ag.biom.grass.kg.ha')
mod.out.fc$date <- as.Date( mod.out.fc$datetime ,  format="%Y-%m-%d")
nr.fut.sum.start <- as.Date("2030-01-01")
nr.fut.sum.end <- as.Date("2030-12-31")
period.2.average <- seq( from = nr.fut.sum.start , to = nr.fut.sum.end, by = 'day' )
num.simulation.months <<- interval(  nr.fut.sum.start,  nr.fut.sum.end  ) %/% days(1)
num.osv.months <<- interval(  min(d.all$date) ,   max(d.all$date)  ) %/% days(1)
# GPP
mod.out.fc$GPP.sim <- cv.sq.m.2.ha * ( mod.out.fc$co2.upt )
# Reco
mod.out.fc$TER.sim <- cv.sq.m.2.ha *  ( mod.out.fc$maint.resp +  mod.out.fc$transp.resp +  mod.out.fc$growth.resp) +  mod.out.fc$emis.hetero
# NET ECOSYSTEM EXCHANGE
mod.out.fc$NEE.mod <- (1) * mod.out.fc$TER.sim - mod.out.fc$GPP.sim
# HERBACEOUS BIOMASS
mod.out.fc$ag.biom.grass.Mg.ha <- mod.out.fc$ag.biom.kg.m2  * cv.sq.m.2.ha / 1000
mod.out.fc <- define.seasons(mod.out.fc , 'date')
names(mod.out.fc) <- make.unique(  names(  mod.out.fc  ) )
} # INDICATOR COMPUTATION
# ASSIGN AVERAGE VALUES UNDER 'GCM 0' FOR MAIN REPORTING VARIABLES
mod.out.fc <- gen.mean.gcm.dat( mod.out.fc , r.4 , cols.2.average , period.2.average)
cols.2.average
d.frame <- mod.out.fc ;  rcp <- r.4 ; columns <- cols.2.average  ; period <- period.2.average
nrow.start <- nrow( d.frame )
nrow.start
d <- period[1]
date <- as.Date(d)
if (  d == period[1] ) { new.row <- nrow.start + 1
} else { new.row <- new.row + 1  }
print(paste('Running date ' , date) )
d.frame[  new.row  , 'gcm'] <- 0
d.frame[  new.row  , 'rcp'] <-  rcp
d.frame[  new.row  , 'date'] <-  date
gen.mean.gcm.dat <<- function( d.frame , rcp, columns , period ){
# test: rcp <- r.8
# test: d.frame <- mod.out.fc ;  rcp <- r.4 ; columns <- cols.2.average  ; period <- period.2.average
nrow.start <- nrow( d.frame )
for ( d in period  ) {
# d <- period[1]
date <- as.Date(d)
if (  d == period[1] ) { new.row <- nrow.start + 1
} else { new.row <- new.row + 1  }
print(paste('Running date ' , date) )
d.frame[  new.row  , 'gcm'] <- 0
d.frame[  new.row  , 'rcp'] <-  rcp
d.frame[  new.row  , 'date'] <-  date
for ( c in columns  ) {
# c <- columns[1]
print(paste('Running variable ' , c) )
d.frame[  new.row , c] <- mean(
d.frame[ d.frame$rcp == rcp &  d.frame$gcm == 1 & d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp) , c]
,  d.frame[  d.frame$rcp == rcp & d.frame$gcm == 2 & d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp) , c]
,  d.frame[  d.frame$rcp == rcp & d.frame$gcm == 3 & d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp) , c]
, d.frame[  d.frame$rcp == rcp & d.frame$gcm == 4 & d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp) , c]
, d.frame[  d.frame$rcp == rcp & d.frame$gcm == 5 & d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp) , c]
, d.frame[  d.frame$rcp == rcp & d.frame$gcm == 6 & d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp) , c]
, d.frame[  d.frame$rcp == rcp & d.frame$gcm == 7 & d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp) , c]
)
}
}
d.frame <- d.frame[   !is.na(   d.frame$date  )  ,  ]
return (  d.frame  )
}
# ASSIGN AVERAGE VALUES UNDER 'GCM 0' FOR MAIN REPORTING VARIABLES
