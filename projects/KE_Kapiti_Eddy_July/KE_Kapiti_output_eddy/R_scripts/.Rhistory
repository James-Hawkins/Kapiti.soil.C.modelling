mod.out.fc[ (mod.out.fc$TER.sim > 70 | mod.out.fc$TER.sim < -70) & !is.na(mod.out.fc$TER.sim) , 'TER.sim' ] <- median( na.omit(mod.out.fc$TER.sim ))
# NET ECOSYSTEM EXCHANGE
mod.out.fc$NEE.mod <- (1) * mod.out.fc$TER.sim - mod.out.fc$GPP.sim
# HERBACEOUS BIOMASS
mod.out.fc$ag.biom.grass.Mg.ha <- mod.out.fc$ag.biom.delta.kg.m2  * cv.sq.m.2.ha / 1000
