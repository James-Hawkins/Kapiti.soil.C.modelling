d.all <- as.data.frame(d.all)
d.all <- d.all[,!duplicated(colnames(d.all))]
d.all$date<- as.Date(d.all$date)
source('gg.params.R')
source('gg.seasons.R')
d.all.plot.conditions <- (!(d.all$omit.period.2)  & d.all$date >= start.date.cald  & d.all$date <= end.date.cald   )
