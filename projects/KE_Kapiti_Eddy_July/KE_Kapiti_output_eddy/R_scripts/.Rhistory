gen.mean.gcm.dat <<- function( d.frame , rcp, columns , period ){
# test: rcp <- r.8
# test: d.frame <- mod.out.fc ;  rcp <- r.4 ; columns <- cols.2.average  ; period <- period.2.average
nrow.start <- nrow( d.frame )
for ( d in period  ) {
# d <- period[2]
date <- as.Date(d)
if (  d == period[1] ) { new.row <- nrow.start + 1
} else { new.row <- new.row + 1  }
print(paste('Running date ' , date ,'for rcp ' ,  rcp) )
d.frame[  new.row  , 'gcm'] <- 0
d.frame[  new.row  , 'rcp'] <-  rcp
d.frame[  new.row  , 'date'] <-  date
for ( c in columns  ) {
# c <- columns[6]
if ( c == "ag.biom.grass.delta.kg.m2" & d == period[1] ) { d.frame[  new.row , c] <-0 ; next }
r.cnd <- d.frame$rcp == rcp &  d.frame$date == date & !is.na(d.frame$gcm) & !is.na(d.frame$rcp)
#   any( r.cnd)
d.frame[  new.row , c] <- mean(
d.frame[  r.cnd & d.frame$gcm == 1 , c]
,  d.frame[  r.cnd & d.frame$gcm == 2 , c]
,  d.frame[ r.cnd & d.frame$gcm == 3   , c]
, d.frame[  r.cnd & d.frame$gcm == 4  , c]
, d.frame[   r.cnd & d.frame$gcm == 5 , c]
, d.frame[  r.cnd & d.frame$gcm == 6 , c]
, d.frame[  r.cnd & d.frame$gcm == 7 , c]
)
}
}
#  View(d.frame[d.frame$gcm == 0 , ])
d.frame <- d.frame[   !is.na(   d.frame$date  )  ,  ]
return (  d.frame  )
}
